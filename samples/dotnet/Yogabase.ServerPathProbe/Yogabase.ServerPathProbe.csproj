<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Yogabase.Samples.ServerPathProbe</RootNamespace>
    <AssemblyName>Yogabase.ServerPathProbe</AssemblyName>
    <!-- Not a shipped client: an Editor-free operator tool that exercises the .NET client's
         Servers, Functions and Realtime surfaces from the owner's own terminal. It carries no
         package identity and must never be packed or published alongside the SDK packages. -->
    <IsPackable>false</IsPackable>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/dotnet/Yogabase.Yogabase.Client/Yogabase.Yogabase.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets the argument-parsing and preview-formatting logic stay internal (this is a sample, not
         a published surface) while its test project still exercises it directly. -->
    <InternalsVisibleTo Include="Yogabase.ServerPathProbe.Tests" />
  </ItemGroup>
</Project>
