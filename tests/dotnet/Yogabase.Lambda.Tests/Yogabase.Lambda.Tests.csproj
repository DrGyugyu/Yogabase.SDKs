<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>true</IsTestingPlatformApplication>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Test-only. Yogabase.Lambda deliberately does not reference this package and resolves
         IHttpClientFactory by name; referencing the real package here is what proves that lookup
         binds to the actual runtime interface rather than to a local look-alike. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/dotnet/Yogabase.Lambda/Yogabase.Lambda.csproj" />
  </ItemGroup>
</Project>
