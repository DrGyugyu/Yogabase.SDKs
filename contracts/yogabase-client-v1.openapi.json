{
  "openapi": "3.1.0",
  "info": {
    "title": "Yogabase Yogabase Application API",
    "version": "v1-preview",
    "description": "Target-local Yogabase application-plane API. This contract excludes Yogabase management, delivery, provisioning, CRDs, raw SQL, provider coordinates, and GameSessions. The client-facing Data API was withdrawn on 2026-09-08: the /v1/data/{resource}/* operations and the data-rest capability id are gone, and a client reaches data through a Lambda, Auth, Storage or Realtime instead. A server that still serves them is older than this document."
  },
  "servers": [
    {
      "url": "https://{gatewayHost}",
      "variables": {
        "gatewayHost": {
          "default": "yogabase.yogabase.invalid",
          "description": "The exact TLS gateway origin returned by the client bootstrap document."
        }
      }
    }
  ],
  "x-yogabase-realtime": {
    "transport": "SignalR",
    "path": "/v1/realtime",
    "defaultHubProtocol": "json",
    "supportedHubProtocols": ["json", "messagepack"],
    "protocolSelection": "client-handshake",
    "clientMethods": ["Subscribe", "Unsubscribe", "InvokeLambda"],
    "lambdaIngress": {
      "selection": "signed-artifact-binding",
      "durability": "ysql-queue-or-platform-actor",
      "inlineSandboxExecution": false
    },
    "events": [
      {
        "clientMethod": "message",
        "schema": "yogabase.lambda-realtime-event.v1",
        "delivery": "at-least-once",
        "dedupeKey": "eventId",
        "selection": "signed-artifact-egress-binding"
      }
    ],
    "status": "available-when-runtime-projection-ready"
  },
  "paths": {
    "/v1/client-config/{publishableKey}": {
      "get": {
        "operationId": "getYogabaseClientConfiguration",
        "description": "Resolves secret-free configuration. A publishable key identifies configuration and never authenticates a request.",
        "security": [],
        "parameters": [
          { "$ref": "#/components/parameters/PublishableKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ClientConfiguration" },
          "404": { "$ref": "#/components/responses/ClientConfigurationNotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "operationId": "signUpYogabaseUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignUpRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/NoContent" },
          "400": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "loginYogabaseUser",
        "description": "Verifies a local project password and establishes the protected interactive session used by the authorization and MFA endpoints.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" },
          "202": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutYogabaseUser",
        "security": [],
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" }
        }
      }
    },
    "/auth/email/confirm": {
      "post": {
        "operationId": "confirmYogabaseEmail",
        "description": "Consumes the exact user id and one-time token delivered in the authentication-email action.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/EmailConfirmationRequest" } }
          }
        },
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" },
          "400": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/auth/password/reset/request": {
      "post": {
        "operationId": "requestYogabasePasswordReset",
        "description": "Always returns the same accepted response so account existence and throttling are not disclosed.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetRequest" } }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/NoContent" }
        }
      }
    },
    "/auth/password/reset/complete": {
      "post": {
        "operationId": "completeYogabasePasswordReset",
        "description": "Consumes the exact user id and one-time token delivered in the authentication-email action.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetCompletionRequest" } }
          }
        },
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" },
          "400": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/auth/mfa/setup": {
      "post": {
        "operationId": "setupYogabaseMfa",
        "description": "Returns an authenticator enrollment key only to the protected interactive project session.",
        "security": [],
        "responses": {
          "200": {
            "description": "Authenticator enrollment material.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MfaSetupResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/mfa/confirm": {
      "post": {
        "operationId": "confirmYogabaseMfa",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MfaCodeRequest" } }
          }
        },
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" },
          "400": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/auth/mfa/verify": {
      "post": {
        "operationId": "verifyYogabaseMfa",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MfaCodeRequest" } }
          }
        },
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/auth/mfa/recovery/regenerate": {
      "post": {
        "operationId": "regenerateYogabaseRecoveryCodes",
        "security": [],
        "responses": {
          "200": {
            "description": "A replacement set of single-use recovery codes.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/RecoveryCodesResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/auth/mfa/recovery/use": {
      "post": {
        "operationId": "useYogabaseRecoveryCode",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RecoveryCodeRequest" } }
          }
        },
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/external/{provider}/callback": {
      "post": {
        "operationId": "completeYogabaseExternalLogin",
        "description": "Completes a configured external identity flow. The callback never auto-links by email and returns unavailable when no installation verifier exists.",
        "security": [],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-z0-9._-]{1,64}$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ExternalIdentityCallbackRequest" } }
          }
        },
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" },
          "202": { "$ref": "#/components/responses/Problem" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/storage/objects/{key}": {
      "put": {
        "operationId": "putYogabaseObject",
        "parameters": [
          { "$ref": "#/components/parameters/ObjectKey" },
          { "$ref": "#/components/parameters/ContentDigest" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": { "type": "string", "contentEncoding": "binary" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/ObjectWrite" },
          "201": { "$ref": "#/components/responses/ObjectWrite" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      },
      "get": {
        "operationId": "getYogabaseObject",
        "parameters": [{ "$ref": "#/components/parameters/ObjectKey" }],
        "responses": {
          "200": {
            "description": "Object bytes. No digest response header exists in v1, so download integrity verification is not claimed.",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "contentEncoding": "binary" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/projects/{projectId}/functions/{functionId}/versions/{functionVersion}/invoke": {
      "post": {
        "operationId": "invokeYogabaseFunction",
        "security": [{ "projectOAuth": ["lambda.invoke"] }],
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/FunctionId" },
          { "$ref": "#/components/parameters/FunctionVersion" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InvocationRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/InvocationResult" },
          "202": { "$ref": "#/components/responses/InvocationResult" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/InvocationResult" },
          "408": { "$ref": "#/components/responses/InvocationResult" },
          "409": { "$ref": "#/components/responses/InvocationResult" },
          "422": { "$ref": "#/components/responses/InvocationResult" },
          "503": { "$ref": "#/components/responses/InvocationResult" }
        }
      }
    },
    "/v1/projects/{projectId}/actors/{functionId}/versions/{functionVersion}/instances/{instanceKey}/invoke": {
      "post": {
        "operationId": "invokeYogabaseActorLambda",
        "description": "Synchronously invokes one project-scoped Actor Lambda instance. The canonical local subject is carried to customer code; application authorization remains part of the admitted Function contract.",
        "security": [{ "projectOAuth": ["lambda.invoke"] }],
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/FunctionId" },
          { "$ref": "#/components/parameters/FunctionVersion" },
          { "$ref": "#/components/parameters/ActorInstanceKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ActorInvocationRequest" } }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/ActorInvocationResult" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "408": { "$ref": "#/components/responses/ActorInvocationResult" },
          "409": { "$ref": "#/components/responses/ActorInvocationResult" },
          "422": { "$ref": "#/components/responses/ActorInvocationResult" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/projects/{projectId}/workflows/{workflowId}/versions/{definitionVersion}/start": {
      "post": {
        "operationId": "startYogabaseWorkflowLambda",
        "description": "Starts or idempotently replays one exact immutable Workflow definition.",
        "security": [{ "projectOAuth": ["lambda.invoke"] }],
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/WorkflowId" },
          { "$ref": "#/components/parameters/WorkflowDefinitionVersion" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowStartRequest" } }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/WorkflowStartResult" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/projects/{projectId}/workflows/instances/{workflowInstanceId}/cancel": {
      "post": {
        "operationId": "cancelYogabaseWorkflowLambda",
        "description": "Idempotently cancels and compensates a non-terminal Workflow owned by the same canonical local subject. Arbitrary signals are not part of v1.",
        "security": [{ "projectOAuth": ["lambda.invoke"] }],
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/WorkflowInstanceId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowCancelRequest" } }
          }
        },
        "responses": {
          "204": { "$ref": "#/components/responses/NoContent" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "422": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/servers/start": {
      "post": {
        "operationId": "startYogabaseGameServer",
        "description": "Allocates one Ready instance of a hosted service to the signed-in player and returns the address to connect to. The Control Plane decides which instance; the gateway relays. A project with no Ready instance carrying an observed address is refused with server_none_available rather than given an address nothing answers on.",
        "security": [{ "projectOAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/GameServerStartRequest" } }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/GameServer" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Problem" },
          "429": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/servers": {
      "get": {
        "operationId": "listYogabaseGameServers",
        "description": "Every instance of the caller's environment as a bare array, ordered by server id. An instance whose address no member has observed is listed with an empty networkPorts rather than omitted or given a composed host.",
        "security": [{ "projectOAuth": [] }],
        "responses": {
          "200": {
            "description": "The instances this caller may see.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/GameServer" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/servers/{serverId}": {
      "get": {
        "operationId": "getYogabaseGameServer",
        "description": "One instance of the caller's environment. A server id from another project is answered exactly as one that does not exist.",
        "security": [{ "projectOAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ServerId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/GameServer" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/servers/{serverId}/stop": {
      "post": {
        "operationId": "stopYogabaseGameServer",
        "description": "Releases the allocation this caller holds on one instance, returning it to the pool. It is never a deletion: retirement is decided by the environment's own capacity policy, and an instance allocated to a different caller is refused with server_stop_not_available.",
        "security": [{ "projectOAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ServerId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/GameServer" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "projectOAuth": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/connect/authorize",
            "tokenUrl": "/connect/token",
            "scopes": {
              "openid": "Identify the local project user.",
              "offline_access": "Request a rotating refresh-token family.",
              "lambda.invoke": "Invoke admitted project Functions."
            }
          }
        }
      }
    },
    "parameters": {
      "PublishableKey": {
        "name": "publishableKey",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^sy_pub_[!-~]{9,153}$", "maxLength": 160 }
      },
      "ServerId": {
        "name": "serverId",
        "in": "path",
        "required": true,
        "description": "Opaque game-server instance identifier, as returned by start or list.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "ObjectKey": {
        "name": "key",
        "in": "path",
        "required": true,
        "description": "Project-local logical key. The live route is a catch-all path tail; SDKs must validate the key and percent-encode each segment separately while preserving literal slash separators.",
        "x-yogabase-catch-all-path-tail": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "ContentDigest": {
        "name": "X-Yogabase-Content-Sha256",
        "in": "header",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Sha256Digest" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "FunctionId": {
        "name": "functionId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "FunctionVersion": {
        "name": "functionVersion",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "ActorInstanceKey": {
        "name": "instanceKey",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^/\\\\?#%\\u0000-\\u001F\\u007F]+$" }
      },
      "WorkflowId": {
        "name": "workflowId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "WorkflowDefinitionVersion": {
        "name": "definitionVersion",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 64 }
      },
      "WorkflowInstanceId": {
        "name": "workflowInstanceId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "responses": {
      "ClientConfiguration": {
        "description": "Secret-free configuration and capability facts.",
        "headers": {
          "Cache-Control": { "schema": { "type": "string", "const": "no-store" } }
        },
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ClientConfiguration" } }
        }
      },
      "ClientConfigurationNotFound": {
        "description": "The same response is used for disabled, malformed, and unknown keys.",
        "headers": {
          "Cache-Control": { "schema": { "type": "string", "const": "no-store" } }
        },
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "ObjectWrite": {
        "description": "Integrity-bound storage receipt.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ObjectWriteResult" } }
        }
      },
      "GameServer": {
        "description": "One game-server instance and the addresses a client may connect to.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/GameServer" } }
        }
      },
      "InvocationResult": {
        "description": "Typed invocation outcome. Expected domain failures retain this shape on non-2xx statuses.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/InvocationResult" } }
        }
      },
      "ActorInvocationResult": {
        "description": "Durable Actor Lambda result.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ActorInvocationResult" } }
        }
      },
      "WorkflowStartResult": {
        "description": "The deterministic durable Workflow instance identity.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowStartResult" } }
        }
      },
      "NoContent": { "description": "Request accepted without secret-bearing output." },
      "Unauthorized": {
        "description": "A valid canonical project bearer subject is required.",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "Problem": {
        "description": "Bounded problem response.",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      },
      "RateLimited": {
        "description": "The fixed-window request limit was exceeded.",
        "content": {
          "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
        }
      }
    },
    "schemas": {
      "GameServerStartRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service"],
        "properties": {
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "description": "Canonical hosted-service id to allocate an instance of."
          },
          "customData": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": { "type": "string", "maxLength": 1024 },
            "propertyNames": { "maxLength": 64 },
            "description": "Bounded string map recorded on the allocation and carried to the instance. At most 4096 bytes as canonical JSON. It reaches customer code, so it must never carry a credential or another player's identity."
          }
        }
      },
      "GameServerPort": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "internalPort", "externalPort", "protocol", "host"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 15 },
          "internalPort": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Port the workload listens on inside its Pod." },
          "externalPort": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Port to connect to on host." },
          "protocol": { "type": "string", "enum": ["tcp", "udp"] },
          "host": { "type": "string", "minLength": 1, "maxLength": 45, "description": "Node address the member observed. Never composed by the Control Plane." }
        }
      },
      "GameServer": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serverId", "state", "networkPorts"],
        "properties": {
          "serverId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "state": {
            "type": "string",
            "maxLength": 32,
            "description": "Lifecycle state, verbatim. Read it as text: a state Yogabase adds later must stay readable rather than fail a client."
          },
          "networkPorts": {
            "type": "array",
            "maxItems": 16,
            "items": { "$ref": "#/components/schemas/GameServerPort" },
            "description": "Empty when no member has observed an address for this instance; a client must not connect to such an instance."
          }
        }
      },
      "ClientConfiguration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "projectId", "environmentId", "gatewayEndpoint", "realtimeEndpoint", "oidcAuthority", "oidcDiscoveryEndpoint", "oidcPublicClientId", "oidcScopes", "oidcRedirectUris", "realtimePath", "capabilities", "issuedAt"],
        "properties": {
          "schema": { "type": "string", "const": "yogabase-client-config.v1" },
          "projectId": { "type": "string", "format": "uuid" },
          "environmentId": { "type": "string", "format": "uuid" },
          "gatewayEndpoint": { "type": "string", "format": "uri" },
          "realtimeEndpoint": { "type": "string", "format": "uri", "description": "Exact HTTPS origin of the separately deployed SignalR realtime gateway." },
          "oidcAuthority": { "type": "string", "format": "uri" },
          "oidcDiscoveryEndpoint": { "type": "string", "format": "uri" },
          "oidcPublicClientId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "oidcScopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "maxLength": 128 }
          },
          "oidcRedirectUris": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "description": "Exact OAuth redirect allowlist. Entries are public HTTPS URLs, loopback HTTP URLs, or lowercase reverse-domain private-use native schemes such as com.example.app:/oauth/callback. Userinfo, query strings, and fragments are forbidden.",
            "items": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^(?!.*[@?#])(?:https://|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?/|[a-z][a-z0-9]*(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}:/).+$"
            }
          },
          "realtimePath": { "type": "string", "const": "/v1/realtime" },
          "capabilities": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "$ref": "#/components/schemas/Capability" }
          },
          "issuedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Capability": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "available"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["auth", "storage", "functions-rest", "realtime-subscribe"]
          },
          "available": { "type": "boolean" },
          "unavailableReason": { "type": ["string", "null"], "maxLength": 256 }
        }
      },
      "SignUpRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 320 },
          "password": { "type": "string", "format": "password", "maxLength": 1024 },
          "invitationToken": { "type": ["string", "null"], "maxLength": 8192 }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 320 },
          "password": { "type": "string", "format": "password", "maxLength": 1024 }
        }
      },
      "EmailConfirmationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userId", "token"],
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "token": { "type": "string", "minLength": 1, "maxLength": 8192 }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 320 }
        }
      },
      "PasswordResetCompletionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userId", "token", "password"],
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "token": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "password": { "type": "string", "format": "password", "maxLength": 1024 }
        }
      },
      "MfaCodeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "RecoveryCodeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "ExternalIdentityCallbackRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "state"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "state": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      },
      "MfaSetupResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sharedKey"],
        "properties": {
          "sharedKey": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      },
      "RecoveryCodesResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recoveryCodes"],
        "properties": {
          "recoveryCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      },
      "ObjectWriteResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "digest", "sizeBytes", "encryption", "alreadyExisted"],
        "properties": {
          "key": { "type": "string" },
          "digest": { "$ref": "#/components/schemas/Sha256Digest" },
          "sizeBytes": { "type": "integer", "format": "int64", "minimum": 1 },
          "encryption": { "type": "string", "minLength": 1 },
          "alreadyExisted": { "type": "boolean" }
        }
      },
      "InvocationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotencyKey", "correlationId", "deadline", "mode", "payloadDigest"],
        "properties": {
          "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
          "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "deadline": { "type": "string", "format": "date-time" },
          "mode": { "type": "integer", "format": "int32", "enum": [0, 1] },
          "payloadDigest": { "$ref": "#/components/schemas/Sha256Digest" },
          "inlinePayloadBase64": { "type": ["string", "null"], "contentEncoding": "base64", "maxLength": 1398104 },
          "objectReference": {
            "oneOf": [{ "$ref": "#/components/schemas/ObjectReference" }, { "type": "null" }]
          }
        },
        "oneOf": [
          { "required": ["inlinePayloadBase64"] },
          { "required": ["objectReference"] }
        ]
      },
      "ActorInvocationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotencyKey", "correlationId", "deadline", "payloadDigest", "inlinePayloadBase64"],
        "properties": {
          "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
          "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "deadline": { "type": "string", "format": "date-time", "description": "Must be within 30 seconds of admission." },
          "payloadDigest": { "$ref": "#/components/schemas/Sha256Digest" },
          "inlinePayloadBase64": { "type": "string", "contentEncoding": "base64", "maxLength": 655360 }
        }
      },
      "ActorInvocationResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "invocationId", "correlationId", "stateVersion"],
        "properties": {
          "status": { "type": "string", "enum": ["InProgress", "Completed", "Failed"] },
          "invocationId": { "type": "string", "format": "uuid" },
          "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "resultReference": { "type": ["string", "null"], "pattern": "^object://", "maxLength": 2048 },
          "failureCode": { "type": ["string", "null"], "pattern": "^[a-z0-9_]{1,128}$" },
          "stateVersion": { "type": "integer", "format": "int64", "minimum": 0 }
        }
      },
      "WorkflowStartRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotencyKey", "payloadDigest", "inlineInputBase64"],
        "properties": {
          "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
          "payloadDigest": { "$ref": "#/components/schemas/Sha256Digest" },
          "inlineInputBase64": { "type": "string", "contentEncoding": "base64", "maxLength": 655360 }
        }
      },
      "WorkflowStartResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflowInstanceId"],
        "properties": {
          "workflowInstanceId": { "type": "string", "format": "uuid" }
        }
      },
      "WorkflowCancelRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotencyKey", "payloadDigest", "inlinePayloadBase64"],
        "properties": {
          "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
          "payloadDigest": { "$ref": "#/components/schemas/Sha256Digest" },
          "inlinePayloadBase64": { "type": "string", "contentEncoding": "base64", "maxLength": 655360 }
        }
      },
      "ObjectReference": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "version"],
        "properties": {
          "uri": { "type": "string", "pattern": "^object://", "maxLength": 2048 },
          "version": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "InvocationResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "invocationId", "correlationId"],
        "properties": {
          "outcome": { "type": "integer", "format": "int32", "enum": [0, 1, 2, 3, 4, 5, 6, 7, 8] },
          "invocationId": { "type": "string", "format": "uuid" },
          "correlationId": { "type": "string", "maxLength": 128 },
          "inlineResultBase64": { "type": ["string", "null"], "contentEncoding": "base64", "maxLength": 1398104 },
          "resultReference": { "type": ["string", "null"], "pattern": "^object://", "maxLength": 2048 },
          "failureCode": { "type": ["string", "null"], "pattern": "^[a-z0-9_]{1,128}$" }
        }
      },
      "Sha256Digest": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "Problem": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer", "format": "int32" },
          "detail": { "type": "string" },
          "traceId": { "type": "string" },
          "code": { "type": "string" },
          "extensions": { "type": "object", "additionalProperties": true }
        }
      }
    }
  },
  "security": [
    { "projectOAuth": [] }
  ]
}
