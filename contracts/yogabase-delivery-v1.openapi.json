  "openapi": "3.1.0",
  "info": {
    "title": "Yogabase Delivery API",
    "version": "v1",
    "description": "Workload-only delivery API. Human delivery administration is deliberately outside this host and contract."
  },
  "servers": [
    {
      "url": "https://{deliveryHost}",
      "variables": {
        "deliveryHost": {
          "description": "The release-configured, TLS-only workload delivery host.",
          "default": "delivery.yogabase.invalid"
        }
      }
    }
  ],
  "security": [
    {
      "deliveryBearer": []
    }
  ],
